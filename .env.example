# ==============================================================================
# KORA Restaurant QR Ordering System — Environment Variables
# ==============================================================================
# Dual-Mode Operation:
# - Leave Supabase/Razorpay empty to run immediately out-of-the-box with local
#   persistent JSON storage + built-in Server-Sent Events (SSE) realtime engine
#   + simulated Razorpay checkout with real HMAC-SHA256 verification.
# - Populate Supabase & Razorpay keys below for production PostgreSQL + live UPI.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=kora-dev-hmac-secret-change-in-production-32chars

# Supabase (Optional — enables PostgreSQL + Supabase Auth + Supabase Realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Optional — enables live Razorpay Orders API & signed Webhooks)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
